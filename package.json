{
  "name": "gphotos-desktop",
  "productName": "gPhotos",
  "version": "1.0.0",
  "description": "gPhotos Desktop - Standalone Photo Manager with Face Recognition and Places Map",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "test:imports": "node test/verify_imports_and_runtime.js",
    "test:render": "npx tsx test/test_rendered_app_startup.ts",
    "test:smoke": "node test/smoke_test_app_ready.js",
    "test:workflow": "npx tsx test/test_5photo_library_workflow.ts",
    "test:dedup-heic": "npx tsx test/test_selected_dedup_and_heic_rotate.ts",
    "test:mobile-auth": "cross-env ELECTRON_RUN_AS_NODE=1 node_modules/electron/dist/electron.exe node_modules/tsx/dist/cli.mjs test/test_mobile_web_server.ts",
    "test:vitest": "cross-env ELECTRON_RUN_AS_NODE=1 node_modules/electron/dist/electron.exe node_modules/vitest/vitest.mjs run",
    "test": "npm run test:imports && npm run test:render && npm run test:smoke && npm run test:workflow && npm run test:dedup-heic && npm run test:mobile-auth && npm run test:vitest",
    "build:ui": "vite build",
    "copy:splash": "node -e \"const fs=require('fs'); fs.mkdirSync('dist-electron/main', {recursive:true}); fs.copyFileSync('src/main/splash.html', 'dist-electron/main/splash.html');\"",
    "build:electron": "tsc -p tsconfig.electron.json && npm run copy:splash",
    "build": "npm test && vite build && tsc -p tsconfig.electron.json && npm run copy:splash",
    "dist:win": "npm run build && electron-builder --win",
    "serve:mobile": "node scripts/serve_mobile.js",
    "start": "electron ."
  },
  "keywords": [
    "photo-gallery",
    "photo-manager",
    "face-recognition",
    "exif",
    "gps-map",
    "electron"
  ],
  "author": "Sachin Bhavsar",
  "license": "MIT",
  "dependencies": {
    "electron-log": "^5.4.4",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.45.0",
    "onnxruntime-node": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "script-runner": "^0.1.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  }
}
