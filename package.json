{
  "name": "gphotos-desktop",
  "productName": "gPhotos",
  "version": "1.0.0",
  "description": "Google Photos Desktop Clone - Standalone Windows Photo Manager with Face Recognition and Places Map",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "build:ui": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "dist:win": "npm run build && electron-builder --win",
    "serve:mobile": "node scripts/serve_mobile.js",
    "start": "electron ."
  },
  "keywords": [
    "google-photos",
    "photo-manager",
    "face-recognition",
    "exif",
    "gps-map",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@vladmandic/face-api": "^1.7.15",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
